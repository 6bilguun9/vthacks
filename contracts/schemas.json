{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vthacks:contracts:v1",
  "$defs": {
    "Money": { "type": "integer", "minimum": 0, "maximum": 9007199254740991, "description": "Nonnegative integer USD cents." },
    "SignedMoney": { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
    "Date": { "type": "string", "format": "date" },
    "NullableDate": { "anyOf": [{ "$ref": "#/$defs/Date" }, { "type": "null" }] },
    "NullableMoney": { "anyOf": [{ "$ref": "#/$defs/Money" }, { "type": "null" }] },
    "HealthResponse": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "service", "apiVersion"],
      "properties": {
        "status": { "const": "ok" },
        "service": { "const": "student-finance-api" },
        "apiVersion": { "const": "v1" }
      }
    },
    "ErrorResponse": {
      "type": "object", "additionalProperties": false, "required": ["error"],
      "properties": { "error": {
        "type": "object", "additionalProperties": false, "required": ["code", "message"],
        "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
      } }
    },
    "SourceInfo": {
      "type": "object", "additionalProperties": false, "required": ["kind", "asOf", "fetchedAt", "isStale"],
      "properties": {
        "kind": { "enum": ["nessie_sandbox", "manual", "fixture"] },
        "asOf": { "type": "string", "format": "date-time" },
        "fetchedAt": { "type": ["string", "null"], "format": "date-time" },
        "isStale": { "type": "boolean" }
      }
    },
    "FinancialSnapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "currency", "source", "accounts", "campusBalances", "universityCharges"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "currency": { "const": "USD" },
        "source": { "$ref": "#/$defs/SourceInfo" },
        "accounts": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "name", "type", "balanceCents"],
          "properties": {
            "id": { "type": "string" }, "name": { "type": "string" },
            "type": { "enum": ["checking", "savings", "credit"] },
            "balanceCents": { "$ref": "#/$defs/SignedMoney" }
          }
        } },
        "campusBalances": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "name", "balanceCents", "restriction", "source"],
          "properties": {
            "id": { "type": "string" }, "name": { "type": "string" },
            "balanceCents": { "$ref": "#/$defs/SignedMoney" },
            "restriction": { "type": "string" }, "source": { "$ref": "#/$defs/SourceInfo" }
          }
        } },
        "universityCharges": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["id", "name", "amountCents", "dueDate", "fundingGoalId", "source"],
          "properties": {
            "id": { "type": "string" }, "name": { "type": "string" },
            "amountCents": { "$ref": "#/$defs/Money" }, "dueDate": { "$ref": "#/$defs/NullableDate" },
            "fundingGoalId": { "type": ["string", "null"] }, "source": { "$ref": "#/$defs/SourceInfo" }
          }
        } }
      }
    },
    "Goal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "targetCents", "allocatedCents", "weeklyContributionCents", "contributionStartDate", "targetDate"],
      "properties": {
        "id": { "type": "string", "minLength": 1 }, "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "targetCents": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "allocatedCents": { "$ref": "#/$defs/Money" }, "weeklyContributionCents": { "$ref": "#/$defs/Money" },
        "contributionStartDate": { "$ref": "#/$defs/Date" }, "targetDate": { "$ref": "#/$defs/NullableDate" }
      }
    },
    "CashFlow": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "description", "amountCents", "cadence", "nextDate", "endDate", "certainty"],
      "properties": {
        "id": { "type": "string" }, "kind": { "enum": ["income", "essential"] }, "description": { "type": "string" },
        "amountCents": { "$ref": "#/$defs/Money" }, "cadence": { "enum": ["once", "weekly", "biweekly", "monthly"] },
        "nextDate": { "$ref": "#/$defs/Date" }, "endDate": { "$ref": "#/$defs/NullableDate" },
        "certainty": { "enum": ["estimated", "confirmed"] }
      }
    },
    "PlannedPurchase": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "description", "amountCents", "date", "fundingGoalId", "status", "matchedTransactionId"],
      "properties": {
        "id": { "type": "string" }, "description": { "type": "string" }, "amountCents": { "$ref": "#/$defs/Money" },
        "date": { "$ref": "#/$defs/Date" }, "fundingGoalId": { "type": ["string", "null"] },
        "status": { "enum": ["planned", "completed", "canceled"] }, "matchedTransactionId": { "type": ["string", "null"] }
      }
    },
    "Plan": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "snapshotId", "timezone", "cashBufferCents", "weeklyDiscretionaryCents", "discretionaryRemainingCents", "goals", "cashFlows", "plannedPurchases"],
      "properties": {
        "id": { "type": "string" }, "version": { "type": "integer", "minimum": 1 }, "snapshotId": { "type": "string" },
        "timezone": { "const": "America/New_York" }, "cashBufferCents": { "$ref": "#/$defs/Money" },
        "weeklyDiscretionaryCents": { "$ref": "#/$defs/Money" }, "discretionaryRemainingCents": { "$ref": "#/$defs/SignedMoney" },
        "goals": { "type": "array", "items": { "$ref": "#/$defs/Goal" } },
        "cashFlows": { "type": "array", "items": { "$ref": "#/$defs/CashFlow" } },
        "plannedPurchases": { "type": "array", "items": { "$ref": "#/$defs/PlannedPurchase" } }
      }
    },
    "Projection": {
      "type": "object", "additionalProperties": false,
      "required": ["asOf", "horizonEnd", "feasibility", "minimumUnallocatedCashCents", "goals", "assumptions", "warnings"],
      "properties": {
        "asOf": { "$ref": "#/$defs/Date" }, "horizonEnd": { "$ref": "#/$defs/Date" },
        "feasibility": { "enum": ["feasible", "infeasible", "needs_information"] },
        "minimumUnallocatedCashCents": { "anyOf": [{ "$ref": "#/$defs/SignedMoney" }, { "type": "null" }] },
        "goals": { "type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["goalId", "completionDate", "requiredWeeklyCents"],
          "properties": { "goalId": { "type": "string" }, "completionDate": { "$ref": "#/$defs/NullableDate" }, "requiredWeeklyCents": { "$ref": "#/$defs/NullableMoney" } }
        } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "OverviewResponse": {
      "type": "object", "additionalProperties": false, "required": ["snapshot", "plan", "projection"],
      "properties": { "snapshot": { "$ref": "#/$defs/FinancialSnapshot" }, "plan": { "$ref": "#/$defs/Plan" }, "projection": { "$ref": "#/$defs/Projection" } }
    },
    "ScenarioRequest": {
      "type": "object", "additionalProperties": false,
      "required": ["snapshotId", "planVersion", "kind", "amountCents", "date", "cadence", "goalId"],
      "properties": {
        "snapshotId": { "type": "string" }, "planVersion": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["purchase", "extra_contribution"] },
        "amountCents": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "date": { "$ref": "#/$defs/Date" }, "cadence": { "enum": ["once", "weekly"] },
        "goalId": { "type": ["string", "null"] }
      },
      "allOf": [{ "if": { "properties": { "kind": { "const": "purchase" } } }, "then": { "properties": { "cadence": { "const": "once" } } } }]
    },
    "ScenarioComparison": {
      "type": "object", "additionalProperties": false,
      "required": ["scenarioId", "snapshotId", "planVersion", "status", "before", "after", "funding", "goalImpacts", "assumptions"],
      "properties": {
        "scenarioId": { "type": "string" }, "snapshotId": { "type": "string" }, "planVersion": { "type": "integer", "minimum": 1 },
        "status": { "enum": ["within_budget", "uses_unallocated_cash", "requires_goal_change", "cash_shortfall", "needs_information", "baseline_infeasible"] },
        "before": { "$ref": "#/$defs/Projection" }, "after": { "$ref": "#/$defs/Projection" },
        "funding": {
          "type": "object", "additionalProperties": false, "required": ["discretionaryCents", "unallocatedCents", "goalCents"],
          "properties": { "discretionaryCents": { "$ref": "#/$defs/Money" }, "unallocatedCents": { "$ref": "#/$defs/Money" }, "goalCents": { "$ref": "#/$defs/Money" } }
        },
        "goalImpacts": { "type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["goalId", "originalDate", "revisedDate", "delayDays", "nextWeekExtraCents", "remainingWeeklyExtraCents"],
          "properties": {
            "goalId": { "type": "string" }, "originalDate": { "$ref": "#/$defs/NullableDate" }, "revisedDate": { "$ref": "#/$defs/NullableDate" },
            "delayDays": { "type": ["integer", "null"], "description": "Negative values mean the goal is reached earlier." },
            "nextWeekExtraCents": { "$ref": "#/$defs/NullableMoney" }, "remainingWeeklyExtraCents": { "$ref": "#/$defs/NullableMoney" }
          }
        } },
        "assumptions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "PlanPreviewRequest": {
      "type": "object", "additionalProperties": false, "required": ["expectedVersion", "snapshotId", "proposedPlan"],
      "properties": { "expectedVersion": { "type": "integer", "minimum": 1 }, "snapshotId": { "type": "string" }, "proposedPlan": { "$ref": "#/$defs/Plan" } }
    },
    "PlanPreviewResponse": {
      "type": "object", "additionalProperties": false, "required": ["proposedPlan", "projection"],
      "properties": { "proposedPlan": { "$ref": "#/$defs/Plan" }, "projection": { "$ref": "#/$defs/Projection" } }
    },
    "PlanCommitRequest": {
      "type": "object", "additionalProperties": false, "required": ["expectedVersion", "snapshotId", "idempotencyKey", "change"],
      "properties": {
        "expectedVersion": { "type": "integer", "minimum": 1 }, "snapshotId": { "type": "string" }, "idempotencyKey": { "type": "string", "minLength": 1, "maxLength": 128 },
        "change": { "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["kind", "plan"], "properties": { "kind": { "const": "replace_plan" }, "plan": { "$ref": "#/$defs/Plan" } } },
          { "type": "object", "additionalProperties": false, "required": ["kind", "scenario"], "properties": { "kind": { "const": "apply_scenario" }, "scenario": { "$ref": "#/$defs/ScenarioRequest" } } }
        ] }
      }
    },
    "ChatRequest": {
      "type": "object", "additionalProperties": false, "required": ["message", "snapshotId", "planVersion", "selectedGoalId"],
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 2000 }, "snapshotId": { "type": "string" },
        "planVersion": { "type": "integer", "minimum": 1 }, "selectedGoalId": { "type": ["string", "null"] }
      }
    },
    "ChatResponse": {
      "type": "object", "additionalProperties": false, "required": ["kind", "text", "comparison"],
      "properties": {
        "kind": { "enum": ["clarification", "comparison", "explanation"] }, "text": { "type": "string" },
        "comparison": { "anyOf": [{ "$ref": "#/$defs/ScenarioComparison" }, { "type": "null" }] }
      },
      "allOf": [{ "if": { "properties": { "kind": { "const": "comparison" } } }, "then": { "properties": { "comparison": { "$ref": "#/$defs/ScenarioComparison" } } } }]
    }
  }
}
