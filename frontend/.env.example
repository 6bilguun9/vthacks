# Public configuration only. Next.js embeds NEXT_PUBLIC_* values in the browser bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Future guest authentication / public signup; unused by the starter.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Never place Nessie, ARC, GoDaddy, signing, or Supabase secret keys in this app.
