# Public configuration only. Next.js embeds NEXT_PUBLIC_* values in the browser bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Public browser authentication. Use the same Supabase project as the backend.
# Enable anonymous sign-ins and CAPTCHA in Supabase Auth. A new guest needs
# a completed Turnstile challenge; existing sessions refresh through the SDK.
# Use a publishable key (or legacy anon key), never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# This must be the public site key for the Turnstile setup connected to Supabase.
# Allow the frontend hostname (including localhost for development) in Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Never place Nessie, ARC, GoDaddy, signing, or Supabase secret keys in this app.
