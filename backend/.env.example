# All fields below are optional for the health-only starter.
PORT=3001
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Future integrations: set these only when implementing the adapter.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged key; normal user reads must respect guest authorization/RLS.
SUPABASE_SECRET_KEY=

# Verify the current HTTPS base URL with the Nessie sponsor documentation.
NESSIE_BASE_URL=
NESSIE_API_KEY=
NESSIE_CUSTOMER_ID=

ARC_BASE_URL=https://llm-api.arc.vt.edu/api/v1
ARC_API_KEY=
# A legacy local root .env may instead use llm_arc_api_key; ARC_API_KEY is preferred.
ARC_MODEL=gpt-oss-120b

# ANS CLI production configuration. ANS_API_KEY must be the complete KEY:SECRET pair.
# Keep it only in backend/.env or your deployment secret store.
ANS_BASE_URL=https://api.godaddy.com/
ANS_API_KEY=
ANS_ORGANIZATION=VTHacks
# Register these distinct FQDNs only after their HTTPS routes point to this backend.
COACH_AGENT_HOST=
PLANNER_AGENT_HOST=
ANS_AGENT_VERSION=0.1.0
# Required later for the authenticated coach-to-planner call, not ANS registration.
AGENT_SIGNING_SECRET=
TURNSTILE_SECRET_KEY=
