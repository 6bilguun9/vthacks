# Health works without provider configuration; private routes require Supabase.
PORT=3001
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info

# Required for persistent guest plans. Enable anonymous sign-ins in Supabase Auth.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only privileged key; normal user reads must respect guest authorization/RLS.
SUPABASE_SECRET_KEY=

# Select exactly one server-side AI provider.
AI_PROVIDER=arc
ARC_BASE_URL=https://llm-api.arc.vt.edu/api/v1
ARC_API_KEY=
# A legacy local root .env may instead use llm_arc_api_key; ARC_API_KEY is preferred.
ARC_MODEL=gpt-oss-120b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://saveandspendmoremoneyon.vodka
OPENROUTER_APP_NAME=Hokie Wallet
AI_MODE=off
PRESENTER_USER_IDS=
PLANNER_ALLOW_LOCAL_FALLBACK=false

# Nessie sandbox. Keep the API key server-side and use only read-only endpoints.
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_API_KEY=
# Choose a synthetic customer from `npm run nessie:status`.
NESSIE_CUSTOMER_ID=

# ANS CLI production configuration. ANS_API_KEY must be the complete KEY:SECRET pair.
# Keep it only in backend/.env or your deployment secret store.
ANS_BASE_URL=https://api.godaddy.com/
ANS_API_KEY=
ANS_ORGANIZATION=VTHacks
# Register these distinct FQDNs only after their HTTPS routes point to this backend.
COACH_AGENT_HOST=
PLANNER_AGENT_HOST=
ANS_AGENT_VERSION=0.1.1
# At least 32 random characters; authenticates coach-to-planner calls, not registration.
AGENT_SIGNING_SECRET=
# Configure the Turnstile secret in Supabase Auth CAPTCHA settings, not this app.
